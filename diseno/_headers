# Es un prototipo: que no lo indexen los buscadores
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Página de pago: sin scripts de terceros (la tarjeta se escribe acá) y solo puede hablar con el sitio y con el Worker.
/pago
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://textovivo.kitifica.workers.dev; form-action 'self'; frame-ancestors 'none'; base-uri 'self'
  Cache-Control: no-store
