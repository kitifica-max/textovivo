{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "textovivo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // IA de Cloudflare: moderación de aportes públicos (src/moderacion.ts).
  "ai": { "binding": "AI" },
  // Avisos de vencimiento del plan: todos los días a las 14:00 UTC.
  "triggers": { "crons": ["0 14 * * *"] },
  // El sitio (../diseno) se sirve desde el mismo Worker: un solo origen, sin CORS.
  // Solo estas rutas pasan por el código; todo lo demás sale directo de los archivos.
  "assets": {
    "directory": "../diseno",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/c/*", "/admin/*"]
  },
  "r2_buckets": [{ "binding": "ENVIOS", "bucket_name": "textovivo-envios" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vivotext-concierge",
      "database_id": "9815f181-47a2-4e55-87fb-bb0dbafa95ae",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // URL pública de la página de venta (para los mensajes de "venció, renová").
    "PUBLIC_URL": "https://textovivo.kitifica.workers.dev",
    // Enlace de pago de Wompi creado a mano en el panel (vacío = botón deshabilitado).
    "WOMPI_LINK_URL": "",
    // Video demo antes/después de 30 s (vacío = no se muestra).
    // "1" = acceso gratis con solo el email (sin pago); vacío = flujo de Wompi.
    "ACCESO_GRATIS": "1",
    // Correo (Resend): remitente en el dominio verificado y sitio público para armar los enlaces.
    "CORREO_REMITENTE": "Textifika <textifika@kitifica.com>",
    "SITIO_URL": "https://textifika.kitifica.com",
    // Sitios que pueden llamar a la API con cookie (Netlify reenvía /api/* acá). Separados por coma.
    "ORIGENES_PERMITIDOS": "https://textifika.kitifica.com,https://textifika.netlify.app",
    // Turnstile (captcha). Esta es la clave de PRUEBA de Cloudflare (siempre aprueba): reemplazar por la del widget real.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGQAHk1rtQKQtxYY",
    // Documentos personales: planes que pueden subirlos (coma-separados; «*» = todas las cuentas). Hoy solo «pro» (se otorga a mano).
    "PLANES_PERSONALES": "pro",
    // Revisión automática de aportes: «off» no evalúa · «sombra» evalúa pero siempre pide revisión manual · «on» publica lo que pasa todo.
    "APROBACION_AUTO": "sombra",
    // Modelos de Workers AI (vacío = los que trae el código por defecto).
    "MODELO_REVISION": "",
    "MODELO_SEGURIDAD": "",
    // Cobro con Wompi: «pruebas» acepta pagos de desarrollo (negocio «en desarrollo» en el panel); «produccion» solo pagos reales.
    "WOMPI_MODO": "pruebas",
    "WOMPI_API_URL": "https://api.wompi.sv",
    "WOMPI_ID_URL": "https://id.wompi.sv",
    "VIDEO_URL": "",
    "PRICE_USD": "4.99",
    "RENTAL_DAYS": "30",
    "CALLS_PER_TOKEN": "150"
  }
}
